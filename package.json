{
  "name": "17job",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:report",
    "test:e2e": "node tests/browser-smoke.cjs",
    "preview:file": "npm run build && node scripts/build-preview.mjs",
    "test:core": "node --experimental-strip-types tests/core.test.ts",
    "test:report": "node --experimental-strip-types tests/report.test.ts",
    "test:report:e2e": "node tests/report-browser.cjs",
    "test:design:e2e": "node tests/design-browser.cjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
